<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions" targetNamespace="https://upp.example/teaching"><bpmn:error id="InvalidArticle" name="Неважећи артикал" errorCode="NEVAZECI_ARTIKAL"/><bpmn:process id="Process" isExecutable="false"><bpmn:intermediateCatchEvent id="Item0" name="Порука: чека одређену поруку"><bpmn:messageEventDefinition id="Item0_definition"></bpmn:messageEventDefinition></bpmn:intermediateCatchEvent><bpmn:intermediateCatchEvent id="Item1" name="Тајмер: чека вријеме или рок"><bpmn:timerEventDefinition id="Item1_definition"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent><bpmn:intermediateCatchEvent id="Item2" name="Сигнал: чека општу објаву"><bpmn:signalEventDefinition id="Item2_definition"></bpmn:signalEventDefinition></bpmn:intermediateCatchEvent></bpmn:process><bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Process"><bpmndi:BPMNShape id="Item0_di" bpmnElement="Item0"><dc:Bounds x="90" y="45" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="25" y="110" width="180" height="55"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Item1_di" bpmnElement="Item1"><dc:Bounds x="400" y="45" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="335" y="110" width="180" height="55"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Item2_di" bpmnElement="Item2"><dc:Bounds x="710" y="45" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="645" y="110" width="180" height="55"/></bpmndi:BPMNLabel></bpmndi:BPMNShape></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>