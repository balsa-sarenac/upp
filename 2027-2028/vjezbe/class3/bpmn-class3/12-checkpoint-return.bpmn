<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="https://upp.example/class3">
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane0" name="Служба">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RejectEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Instructions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AgreeEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Refund</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane1" name="Магацин">
        <bpmn:flowNodeRef>Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CloseEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Damaged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Захтјев за поврат">
      <bpmn:messageEventDefinition messageRef="ReturnMessage" />
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="InTime" name="У року од 14 дана?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Reject" name="Послати одбијање">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="RejectEnd" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Instructions" name="Послати упутство за слање">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Receive" name="Примити пакет">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Timer" name="10 дана" attachedToRef="Receive" cancelActivity="true">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P10D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Close" name="Затворити захтјев">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CloseEnd" name="">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Inspect" name="Прегледати артикал">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Damaged" name="Оштећено?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Agree" name="Договорити рјешење са купцем">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="AgreeEnd" name="">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Split" name="">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Refund" name="Вратити новац">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Stock" name="Вратити артикле на стање">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Join" name="">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End" name="Поврат завршен">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="InTime" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="InTime" targetRef="Reject" name="не" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="InTime" targetRef="Instructions" name="да" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Reject" targetRef="RejectEnd" name="" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Instructions" targetRef="Receive" name="" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Timer" targetRef="Close" name="" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Close" targetRef="CloseEnd" name="" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Receive" targetRef="Inspect" name="" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Inspect" targetRef="Damaged" name="" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Damaged" targetRef="Agree" name="да" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Damaged" targetRef="Split" name="не" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Agree" targetRef="AgreeEnd" name="" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Split" targetRef="Refund" name="" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Split" targetRef="Stock" name="" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Refund" targetRef="Join" name="" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Stock" targetRef="Join" name="" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Join" targetRef="End" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1600" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane0_di" bpmnElement="Lane0" isHorizontal="true">
