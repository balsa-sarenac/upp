<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="https://upp.example/class3">
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:startEvent id="Start" name="">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Item" name="Провјерити ставку">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Decision" name="Све ставке у реду?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Order" name="Послати наруџбину">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Yes" name="">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Notify" name="Обавијестити запосленог">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="No" name="">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Item" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Item" targetRef="Decision" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Decision" targetRef="Order" name="да" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Decision" targetRef="Notify" name="не" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Order" targetRef="Yes" name="" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Notify" targetRef="No" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Process">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="40" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-20" y="166" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Item_di" bpmnElement="Item">
        <dc:Bounds x="130" y="100" width="200" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Decision_di" bpmnElement="Decision" isMarkerVisible="true">
        <dc:Bounds x="420" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="295" y="80" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Order_di" bpmnElement="Order">
        <dc:Bounds x="560" y="30" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Yes_di" bpmnElement="Yes">
        <dc:Bounds x="800" y="52" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="740" y="96" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Notify_di" bpmnElement="Notify">
        <dc:Bounds x="560" y="190" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="No_di" bpmnElement="No">
        <dc:Bounds x="800" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="740" y="256" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="76" y="140.0" />
        <di:waypoint x="130" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="330" y="140.0" />
        <di:waypoint x="420" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="445" y="115" />
        <di:waypoint x="445" y="70" />
        <di:waypoint x="560" y="70" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="437.5" y="40.0" width="130" height="44" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="445" y="165" />
        <di:waypoint x="445" y="230" />
        <di:waypoint x="560" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="437.5" y="200.0" width="130" height="44" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="720" y="70.0" />
        <di:waypoint x="800" y="70.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="720" y="230.0" />
        <di:waypoint x="800" y="230.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>