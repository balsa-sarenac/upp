<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="https://upp.example/class3">
  <bpmn:process id="SupplierCheck" isExecutable="false">
    <bpmn:startEvent id="Start" name="Захтјев за провјеру">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Split" name="">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Registry" name="Провјерити регистар">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Debts" name="Провјерити дугове">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Join" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Assess" name="Донијети оцјену">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End" name="Оцјена">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Split" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Split" targetRef="Registry" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Split" targetRef="Debts" name="" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Registry" targetRef="Join" name="" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Debts" targetRef="Join" name="" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Join" targetRef="Assess" name="" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Assess" targetRef="End" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="SupplierCheck">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="40" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-20" y="206" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Split_di" bpmnElement="Split">
        <dc:Bounds x="130" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="5" y="120" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Registry_di" bpmnElement="Registry">
        <dc:Bounds x="255" y="45" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Debts_di" bpmnElement="Debts">
        <dc:Bounds x="255" y="255" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_di" bpmnElement="Join">
        <dc:Bounds x="500" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="375" y="120" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Assess_di" bpmnElement="Assess">
        <dc:Bounds x="620" y="140" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="880" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="820" y="206" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="76" y="180.0" />
        <di:waypoint x="130" y="180.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="155" y="155" />
        <di:waypoint x="155" y="85" />
        <di:waypoint x="255" y="85" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="155" y="205" />
        <di:waypoint x="155" y="295" />
        <di:waypoint x="255" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="415" y="85" />
        <di:waypoint x="525" y="85" />
        <di:waypoint x="525" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="415" y="295" />
        <di:waypoint x="525" y="295" />
        <di:waypoint x="525" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="550" y="180.0" />
        <di:waypoint x="620" y="180.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="780" y="180.0" />
        <di:waypoint x="880" y="180.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>