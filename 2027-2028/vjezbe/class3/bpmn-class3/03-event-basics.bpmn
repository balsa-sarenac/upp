<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="https://upp.example/class3">
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:startEvent id="Start" name="">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:eventBasedGateway id="Wait" name="Шта стиже прво?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Msg" name="Порука">
      <bpmn:messageEventDefinition messageRef="AnyMessage" />
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Timer" name="Рок">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="MsgEnd" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="TimerEnd" name="">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Wait" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Wait" targetRef="Msg" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Wait" targetRef="Timer" name="" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Msg" targetRef="MsgEnd" name="" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Timer" targetRef="TimerEnd" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Process">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="40" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-20" y="176" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Wait_di" bpmnElement="Wait">
        <dc:Bounds x="140" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="15" y="90" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Msg_di" bpmnElement="Msg">
        <dc:Bounds x="300" y="40" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="240" y="84" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_di" bpmnElement="Timer">
        <dc:Bounds x="300" y="220" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="240" y="264" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MsgEnd_di" bpmnElement="MsgEnd">
        <dc:Bounds x="460" y="40" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="400" y="84" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TimerEnd_di" bpmnElement="TimerEnd">
        <dc:Bounds x="460" y="220" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="400" y="264" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="76" y="150.0" />
        <di:waypoint x="140" y="150.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="165" y="125" />
        <di:waypoint x="165" y="58" />
        <di:waypoint x="300" y="58" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="165" y="175" />
        <di:waypoint x="165" y="238" />
        <di:waypoint x="300" y="238" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="336" y="58.0" />
        <di:waypoint x="460" y="58.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="336" y="238.0" />
        <di:waypoint x="460" y="238.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmn:message id="AnyMessage" name="Порука" />
</bpmn:definitions>