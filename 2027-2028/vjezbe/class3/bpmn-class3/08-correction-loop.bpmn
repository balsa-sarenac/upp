<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="https://upp.example/class3">
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane0" name="Референт">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fix</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane1" name="Руководилац">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Prepare" name="Припремити наруџбину">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Merge" name="">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Fix" name="Допунити наруџбину">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Check" name="Прегледати наруџбину">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Decision" name="Потпуна?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End" name="">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Prepare" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Prepare" targetRef="Merge" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Merge" targetRef="Check" name="" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Check" targetRef="Decision" name="" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Decision" targetRef="End" name="да" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Decision" targetRef="Fix" name="не" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Fix" targetRef="Merge" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1000" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane0_di" bpmnElement="Lane0" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="970" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane1_di" bpmnElement="Lane1" isHorizontal="true">
        <dc:Bounds x="50" y="200" width="970" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="100" y="92" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="40" y="136" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Prepare_di" bpmnElement="Prepare">
        <dc:Bounds x="180" y="70" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_di" bpmnElement="Merge" isMarkerVisible="true">
        <dc:Bounds x="420" y="85" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="295" y="50" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fix_di" bpmnElement="Fix">
        <dc:Bounds x="580" y="70" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Check_di" bpmnElement="Check">
        <dc:Bounds x="480" y="250" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Decision_di" bpmnElement="Decision" isMarkerVisible="true">
        <dc:Bounds x="800" y="265" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="675" y="230" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="920" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="860" y="316" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="136" y="110.0" />
        <di:waypoint x="180" y="110.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="360" y="110.0" />
        <di:waypoint x="420" y="110.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="445" y="135" />
        <di:waypoint x="445" y="290" />
        <di:waypoint x="480" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="640" y="290.0" />
        <di:waypoint x="800" y="290.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="850" y="290.0" />
        <di:waypoint x="920" y="290.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="820.0" y="260.0" width="130" height="44" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="825" y="265" />
        <di:waypoint x="825" y="110" />
        <di:waypoint x="760" y="110" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="835.0" y="157.5" width="130" height="44" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="580" y="110" />
        <di:waypoint x="470" y="110" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Pool" name="Набавка" processRef="Process" />
  </bpmn:collaboration>
</bpmn:definitions>