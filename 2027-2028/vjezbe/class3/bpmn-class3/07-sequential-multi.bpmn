<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="https://upp.example/class3">
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane0" name="Референт">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Item</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane1" name="Систем">
        <bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Yes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>No</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Item" name="Прегледати ставку">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Decision" name="Све ставке у реду?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Order" name="Послати наруџбину">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Yes" name="">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Notify" name="Обавијестити запосленог">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="No" name="">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Item" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Item" targetRef="Decision" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Decision" targetRef="Order" name="да" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Decision" targetRef="Notify" name="не" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Order" targetRef="Yes" name="" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Notify" targetRef="No" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1000" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane0_di" bpmnElement="Lane0" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="970" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane1_di" bpmnElement="Lane1" isHorizontal="true">
        <dc:Bounds x="50" y="180" width="970" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="100" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="40" y="126" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Item_di" bpmnElement="Item">
        <dc:Bounds x="180" y="60" width="200" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Decision_di" bpmnElement="Decision" isMarkerVisible="true">
        <dc:Bounds x="440" y="285" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="315" y="250" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Order_di" bpmnElement="Order">
        <dc:Bounds x="580" y="200" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Yes_di" bpmnElement="Yes">
        <dc:Bounds x="840" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="780" y="266" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Notify_di" bpmnElement="Notify">
        <dc:Bounds x="580" y="340" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="No_di" bpmnElement="No">
        <dc:Bounds x="840" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="780" y="406" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="136" y="100.0" />
        <di:waypoint x="180" y="100.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="280" y="140" />
        <di:waypoint x="280" y="310" />
        <di:waypoint x="440" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="465" y="285" />
        <di:waypoint x="465" y="240" />
        <di:waypoint x="580" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="457.5" y="210.0" width="130" height="44" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="465" y="335" />
        <di:waypoint x="465" y="380" />
        <di:waypoint x="580" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="457.5" y="350.0" width="130" height="44" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="740" y="240.0" />
        <di:waypoint x="840" y="240.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="740" y="380.0" />
        <di:waypoint x="840" y="380.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Pool" name="Набавка" processRef="Process" />
  </bpmn:collaboration>
</bpmn:definitions>