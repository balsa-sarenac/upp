oice_di" bpmnElement="Choice" isMarkerVisible="true"><dc:Bounds x="145" y="155" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="107" y="214" width="126" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Continue_di" bpmnElement="Continue"><dc:Bounds x="290" y="35" width="175" height="76"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Reject_di" bpmnElement="Reject"><dc:Bounds x="290" y="265" width="175" height="76"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="YesEnd_di" bpmnElement="YesEnd"><dc:Bounds x="550" y="55" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="512" y="100" width="112" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="NoEnd_di" bpmnElement="NoEnd"><dc:Bounds x="550" y="285" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="512" y="330" width="112" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="61" y="180.0"/><di:waypoint x="145" y="180.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="170" y="155"/><di:waypoint x="170" y="73"/><di:waypoint x="290" y="73"/><bpmndi:BPMNLabel><dc:Bounds x="182.0" y="45.0" width="96" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="170" y="205"/><di:waypoint x="170" y="303"/><di:waypoint x="290" y="303"/><bpmndi:BPMNLabel><dc:Bounds x="182.0" y="275.0" width="96" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="465" y="73.0"/><di:waypoint x="550" y="73.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="465" y="303.0"/><di:waypoint x="550" y="303.0"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>