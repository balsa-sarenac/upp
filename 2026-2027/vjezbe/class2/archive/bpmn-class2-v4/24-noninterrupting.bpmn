<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions" targetNamespace="https://upp.example/teaching"><bpmn:error id="InvalidArticle" name="Неважећи артикал" errorCode="NEVAZECI_ARTIKAL"/><bpmn:process id="Process" isExecutable="false"><bpmn:startEvent id="Start" name=""><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Review" name="Прегледати захтјев"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="Done" name=""><bpmn:incoming>Flow_2</bpmn:incoming></bpmn:endEvent><bpmn:boundaryEvent id="Timer" name="1 дан" attachedToRef="Review" cancelActivity="false"><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:timerEventDefinition id="Timer_definition"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:sendTask id="Handle" name="Послати подсјетник"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:sendTask><bpmn:endEvent id="HandlerEnd" name=""><bpmn:incoming>Flow_4</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Review" name=""/><bpmn:sequenceFlow id="Flow_2" sourceRef="Review" targetRef="Done" name=""/><bpmn:sequenceFlow id="Flow_3" sourceRef="Timer" targetRef="Handle" name=""/><bpmn:sequenceFlow id="Flow_4" sourceRef="Handle" targetRef="HandlerEnd" name=""/></bpmn:process><bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Process"><bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="25" y="82" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="-13" y="127" width="112" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Review_di" bpmnElement="Review"><dc:Bounds x="180" y="62" width="220" height="100"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Done_di" bpmnElement="Done"><dc:Bounds x="650" y="94" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="612" y="139" width="112" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Timer_di" bpmnElement="Timer"><dc:Bounds x="272" y="144" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="145" y="195" width="120" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Handle_di" bpmnElement="Handle"><dc:Bounds x="350" y="315" width="200" height="76"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="HandlerEnd_di" bpmnElement="HandlerEnd"><dc:Bounds x="650" y="335" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="612" y="380" width="112" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="61" y="100"/><di:waypoint x="120" y="100"/><di:waypoint x="120" y="112"/><di:waypoint x="180" y="112"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="400" y="112.0"/><di:waypoint x="650" y="112.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="290" y="180"/><di:waypoint x="290" y="353"/><di:waypoint x="350" y="353"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="550" y="353.0"/><di:waypoint x="650" y="353.0"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>