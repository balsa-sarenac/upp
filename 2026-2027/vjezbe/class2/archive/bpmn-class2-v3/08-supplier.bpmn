" name=""/><bpmn:sequenceFlow id="Flow_2" sourceRef="Send" targetRef="Reply" name=""/><bpmn:sequenceFlow id="Flow_3" sourceRef="Reply" targetRef="Decision" name=""/><bpmn:sequenceFlow id="Flow_4" sourceRef="Decision" targetRef="Order" name="да"/><bpmn:sequenceFlow id="Flow_5" sourceRef="Order" targetRef="Notify" name=""/><bpmn:sequenceFlow id="Flow_6" sourceRef="Decision" targetRef="Notify" name="не"/><bpmn:sequenceFlow id="Flow_7" sourceRef="Deadline" targetRef="Notify" name=""/><bpmn:sequenceFlow id="Flow_8" sourceRef="Notify" targetRef="Done" name=""/></bpmn:process><bpmn:collaboration id="Collaboration"><bpmn:participant id="Supplier" name="Добављач"/><bpmn:participant id="Office" name="Служба набавке" processRef="Process"/><bpmn:messageFlow id="Flow_9" sourceRef="Send" targetRef="Supplier" name="упит"/><bpmn:messageFlow id="Flow_10" sourceRef="Supplier" targetRef="Reply" name="одговор + ID"/><bpmn:messageFlow id="Flow_11" sourceRef="Order" targetRef="Supplier" name="поруџбина"/></bpmn:collaboration><bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration"><bpmndi:BPMNShape id="Supplier_di" bpmnElement="Supplier" isHorizontal="true"><dc:Bounds x="30" y="20" width="1120" height="65"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Office_di" bpmnElement="Office" isHorizontal="true"><dc:Bounds x="30" y="145" width="1120" height="400"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="80" y="237" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="42" y="282" width="112" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Send_di" bpmnElement="Send"><dc:Bounds x="180" y="217" width="140" height="76"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Reply_di" bpmnElement="Reply"><dc:Bounds x="430" y="217" width="180" height="76"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Deadline_di" bpmnElement="Deadline"><dc:Bounds x="500" y="275" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="380" y="325" width="115" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Decision_di" bpmnElement="Decision" isMarkerVisible="true"><dc:Bounds x="700" y="230" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="730" y="292" width="110" height="35"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Order_di" bpmnElement="Order"><dc:Bounds x="900" y="217" width="170" height="76"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Notify_di" bpmnElement="Notify"><dc:Bounds x="850" y="425" width="190" height="76"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Done_di" bpmnElement="Done"><dc:Bounds x="1090" y="445" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1052" y="490" width="112" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="116" y="255.0"/><di:waypoint x="180" y="255.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="320" y="255.0"/><di:waypoint x="430" y="255.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="610" y="255.0"/><di:waypoint x="700" y="255.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="750" y="255.0"/><di:waypoint x="900" y="255.0"/><bpmndi:BPMNLabel><dc:Bounds x="777.0" y="227.0" width="96" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="985" y="293"/><di:waypoint x="985" y="370"/><di:waypoint x="945" y="370"/><di:waypoint x="945" y="425"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="725" y="280"/><di:waypoint x="725" y="463"/><di:waypoint x="850" y="463"/><bpmndi:BPMNLabel><dc:Bounds x="735.0" y="359.5" width="96" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="518" y="311"/><di:waypoint x="518" y="525"/><di:waypoint x="945" y="525"/><di:waypoint x="945" y="501"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1040" y="463.0"/><di:waypoint x="1090" y="463.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="250" y="217"/><di:waypoint x="250" y="85"/><bpmndi:BPMNLabel><dc:Bounds x="260.0" y="105" width="96" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="550" y="85"/><di:waypoint x="550" y="217"/><bpmndi:BPMNLabel><dc:Bounds x="560.0" y="105" width="96" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="985" y="217"/><di:waypoint x="985" y="85"/><bpmndi:BPMNLabel><dc:Bounds x="995.0" y="105" width="96" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>