<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions" targetNamespace="https://upp.example/teaching"><bpmn:error id="InvalidArticle" name="Неважећи артикал" errorCode="NEVAZECI_ARTIKAL"/><bpmn:message id="SupplierReply" name="Одговор добављача"/><bpmn:process id="Process" isExecutable="false"><bpmn:startEvent id="Start" name=""><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:sendTask id="Send" name="Послати упит"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:sendTask><bpmn:receiveTask id="Wait" name="Додати чекање и рок"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:receiveTask><bpmn:endEvent id="End" name=""><bpmn:incoming>Flow_4</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Send" name=""/><bpmn:sequenceFlow id="Flow_3" sourceRef="Send" targetRef="Wait" name=""/><bpmn:sequenceFlow id="Flow_4" sourceRef="Wait" targetRef="End" name=""/></bpmn:process><bpmn:collaboration id="Collaboration"><bpmn:participant id="Supplier" name="Добављач"/><bpmn:participant id="Office" name="Служба набавке" processRef="Process"/><bpmn:messageFlow id="Flow_2" sourceRef="Send" targetRef="Supplier" name="упит"/></bpmn:collaboration><bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration"><bpmndi:BPMNShape id="Supplier_di" bpmnElement="Supplier" isHorizontal="true"><dc:Bounds x="30" y="20" width="1120" height="65"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Office_di" bpmnElement="Office" isHorizontal="true"><dc:Bounds x="30" y="145" width="1120" height="495"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="85" y="282" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="47" y="327" width="112" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Send_di" bpmnElement="Send"><dc:Bounds x="175" y="262" width="130" height="76"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Wait_di" bpmnElement="Wait"><dc:Bounds x="470" y="262" width="180" height="76"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="750" y="282" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="712" y="327" width="112" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="121" y="300.0"/><di:waypoint x="175" y="300.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="240" y="262"/><di:waypoint x="240" y="85"/><bpmndi:BPMNLabel><dc:Bounds x="250.0" y="105" width="96" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="305" y="300.0"/><di:waypoint x="470" y="300.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="650" y="300.0"/><di:waypoint x="750" y="300.0"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>