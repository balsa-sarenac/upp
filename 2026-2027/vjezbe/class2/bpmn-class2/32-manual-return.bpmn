<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions" targetNamespace="https://upp.example/teaching"><bpmn:error id="InvalidArticle" name="Неважећи артикал" errorCode="NEVAZECI_ARTIKAL"/><bpmn:process id="Process" isExecutable="false"><bpmn:subProcess id="Sub" name="Провјерити услове"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:subProcess><bpmn:boundaryEvent id="Deadline" name="48 часова" attachedToRef="Sub" cancelActivity="true"><bpmn:outgoing>Flow_2</bpmn:outgoing><bpmn:timerEventDefinition id="Deadline_definition"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:userTask id="Manual" name="Ручно&#10;провјерити услове"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Merge" name=""><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="Results" name="Оба позитивна?"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Order" name="Наручити робу"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Notice" name="Обавијестити запосленог"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End" name=""><bpmn:incoming>Flow_8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="Sub" targetRef="Merge" name=""/><bpmn:sequenceFlow id="Flow_2" sourceRef="Deadline" targetRef="Manual" name=""/><bpmn:sequenceFlow id="Flow_3" sourceRef="Manual" targetRef="Merge" name=""/><bpmn:sequenceFlow id="Flow_4" sourceRef="Merge" targetRef="Results" name=""/><bpmn:sequenceFlow id="Flow_5" sourceRef="Results" targetRef="Order" name="да"/><bpmn:sequenceFlow id="Flow_6" sourceRef="Results" targetRef="Notice" name="не"/><bpmn:sequenceFlow id="Flow_7" sourceRef="Order" targetRef="Notice" name=""/><bpmn:sequenceFlow id="Flow_8" sourceRef="Notice" targetRef="End" name=""/></bpmn:process><bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Process"><bpmndi:BPMNShape id="Sub_di" bpmnElement="Sub" isExpanded="false"><dc:Bounds x="30" y="30" width="200" height="100"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Deadline_di" bpmnElement="Deadline"><dc:Bounds x="62" y="112" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="105" y="175" width="115" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Manual_di" bpmnElement="Manual"><dc:Bounds x="240" y="250" width="190" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Merge_di" bpmnElement="Merge" isMarkerVisible="true"><dc:Bounds x="450" y="55" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="412" y="114" width="126" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Results_di" bpmnElement="Results" isMarkerVisible="true"><dc:Bounds x="570" y="55" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="615" y="130" width="105" height="45"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Order_di" bpmnElement="Order"><dc:Bounds x="700" y="35" width="190" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Notice_di" bpmnElement="Notice"><dc:Bounds x="700" y="250" width="190" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="950" y="277" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="912" y="322" width="112" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="230" y="80.0"/><di:waypoint x="450" y="80.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="80" y="148"/><di:waypoint x="80" y="295"/><di:waypoint x="240" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="430" y="295"/><di:waypoint x="475" y="295"/><di:waypoint x="475" y="105"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="500" y="80.0"/><di:waypoint x="570" y="80.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="620" y="80.0"/><di:waypoint x="700" y="80.0"/><bpmndi:BPMNLabel><dc:Bounds x="612.0" y="52.0" width="96" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="595" y="105"/><di:waypoint x="595" y="295"/><di:waypoint x="700" y="295"/><bpmndi:BPMNLabel><dc:Bounds x="605.0" y="188.0" width="96" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="795" y="125"/><di:waypoint x="795" y="250"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="890" y="295.0"/><di:waypoint x="950" y="295.0"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>