<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="https://upp.example/class3">
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:startEvent id="Start" name="">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Send" name="Послати упит" messageRef="QueryMessage">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Receive" name="Примити цијену" messageRef="PriceMessage">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="End" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Send" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Send" targetRef="Receive" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Receive" targetRef="End" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="Buyer_di" bpmnElement="Buyer" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="900" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shop_di" bpmnElement="Shop" isHorizontal="true">
        <dc:Bounds x="20" y="320" width="900" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="80" y="92" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="20" y="136" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Send_di" bpmnElement="Send">
        <dc:Bounds x="170" y="70" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Receive_di" bpmnElement="Receive">
        <dc:Bounds x="560" y="70" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="820" y="92" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="760" y="136" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ShopStart_di" bpmnElement="ShopStart">
        <dc:Bounds x="232" y="392" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="172" y="436" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Calc_di" bpmnElement="Calc">
        <dc:Bounds x="330" y="370" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Reply_di" bpmnElement="Reply">
        <dc:Bounds x="560" y="370" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ShopEnd_di" bpmnElement="ShopEnd">
        <dc:Bounds x="820" y="392" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="760" y="436" width="160" height="55" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="116" y="110.0" />
        <di:waypoint x="170" y="110.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="330" y="110.0" />
        <di:waypoint x="560" y="110.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="720" y="110.0" />
        <di:waypoint x="820" y="110.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="268" y="410.0" />
        <di:waypoint x="330" y="410.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="490" y="410.0" />
        <di:waypoint x="560" y="410.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="720" y="410.0" />
        <di:waypoint x="820" y="410.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="250" y="150" />
        <di:waypoint x="250" y="392" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="260" y="240" width="130" height="44" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="640" y="370" />
        <di:waypoint x="640" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="650" y="240" width="130" height="44" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Buyer" name="Купац" processRef="Process" />
    <bpmn:participant id="Shop" name="Продавница" processRef="ShopProcess" />
    <bpmn:messageFlow id="Flow_7" sourceRef="Send" targetRef="ShopStart" name="упит бр. 17" />
    <bpmn:messageFlow id="Flow_8" sourceRef="Reply" targetRef="Receive" name="цијена, бр. 17" />
  </bpmn:collaboration>
  <bpmn:process id="ShopProcess" isExecutable="false">
    <bpmn:startEvent id="ShopStart" name="Упит примљен">
      <bpmn:messageEventDefinition messageRef="QueryMessage" />
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Calc" name="Израчунати цијену">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Reply" name="Послати цијену" messageRef="PriceMessage">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="ShopEnd" name="">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="ShopStart" targetRef="Calc" name="" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Calc" targetRef="Reply" name="" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Reply" targetRef="ShopEnd" name="" />
  </bpmn:process>
  <bpmn:message id="QueryMessage" name="Упит + број" />
  <bpmn:message id="PriceMessage" name="Цијена + број упита" />
</bpmn:definitions>